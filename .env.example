# ==========================================
# SkillBridge AI - Environment Configuration
# ==========================================

# ------------------------------------------
# 1. AI Model API Keys (Optional - Local mock fallback active by default)
# ------------------------------------------
# Google Gemini API Key (recommended for best free-tier quotas & JSON schema performance)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional alternate provider)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------
# 2. Firebase Client Configuration (Dual-Mode: Local fallback active if omitted)
# ------------------------------------------
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ------------------------------------------
# 3. Google Cloud / Deployment Settings
# ------------------------------------------
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1
